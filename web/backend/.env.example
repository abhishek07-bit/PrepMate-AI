# Database URL (PostgreSQL or local SQLite)
DATABASE_URL=sqlite:///./prepmate.db

# JWT Security (must be changed when NODE_ENV=production)
SECRET_KEY=generate-a-secure-random-string-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
NODE_ENV=development

# Allowed Origins (CORS, comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# File Storage
UPLOAD_DIR=./uploads

# Firebase Admin (optional for local JWT-only mode; provide single-line JSON string in production)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# AI Providers (At least one is required)
GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=your-groq-key
OPENROUTER_API_KEY=your-openrouter-key
CEREBRAS_API_KEY=your-cerebras-key
